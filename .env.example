NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only R2 configuration. Use a private EU-jurisdiction bucket.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Exact object keys, not URLs. These five fixed IDs are the playback allowlist.
R2_FIXTURE_MP3_KEY=
R2_FIXTURE_AAC_KEY=
R2_FIXTURE_M4A_KEY=
R2_FIXTURE_LONG_KEY=
R2_FIXTURE_SPECIAL_KEY=
# Optional: 10-900 seconds. Leave unset for 15 minutes; use 10 for expiry checks.
R2_PLAYBACK_TTL_SECONDS=900
